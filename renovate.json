{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":dependencyDashboard",
        ":semanticCommits",
        ":prHourlyLimit2",
        "helpers:pinGitHubActionDigests",
        "schedule:weekly"
    ],
    "labels": [
        "dependencies"
    ],
    "timezone": "Europe/Paris",
    "ignorePaths": [
        "**/bin/**",
        "**/obj/**",
        "**/publish/**",
        "**/artifacts/**"
    ],
    "packageRules": [
        {
            "description": "No packages.lock.json to update, and Renovate's NuGet artifact step fails on the deliberate circular reference in tests/CLI.Tests/Fixtures/InvalidStructure",
            "matchManagers": [
                "nuget"
            ],
            "skipArtifactsUpdate": true
        },
        {
            "description": "Microsoft.Build 18.10+ ships for net11.0 only: on net10.0 NuGet falls back to its .NET Framework build (NU1701). Lift when the projects target net11.0",
            "matchPackageNames": [
                "Microsoft.Build"
            ],
            "allowedVersions": "(,18.10)"
        },
        {
            "description": "Group all GitHub Actions bumps into one PR",
            "matchManagers": [
                "github-actions"
            ],
            "groupName": "github actions"
        },
        {
            "description": "Bump the .NET SDK in global.json and the Docker images together",
            "matchPackageNames": [
                "dotnet-sdk",
                "mcr.microsoft.com/dotnet/**"
            ],
            "groupName": ".NET"
        },
        {
            "description": "Auto-merge non-major updates once required CI checks pass: Renovate merges them itself, after rebasing and retesting, with its bypass of the review required by the PR ruleset",
            "matchUpdateTypes": [
                "minor",
                "patch",
                "digest",
                "pin"
            ],
            "automerge": true,
            "platformAutomerge": false
        }
    ]
}
